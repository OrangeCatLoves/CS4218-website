{
  "baseUrl": "/CS4218-website",
  "faviconPath": "images/favicon.svg",
  "titlePrefix": "CS4218",
  "titleSuffix": "Software Testing",
  "timeZone": "Asia/Singapore",
  "locale": "en-SG",

  "style": {
    "codeTheme": "light",
    "codeLineNumbers": true
  },

  "globalOverride": {
    "pageNav": "default",
    "pageNavTitle": "On this page"
  },

  "pages": [
    {
      "src": "index.md",
      "title": "Welcome to CS4218",
      "layout": "default.md"
    },
    {
      "glob": "overview/**/*.md",
      "title": "Course Overview",
      "layout": "default.md"
    },
    {
      "glob": "schedule/**/*.md",
      "title": "Schedule",
      "layout": "default.md"
    },
    {
      "glob": "project/**/*.md",
      "layout": "default.md"
    },
    {
      "src": "relevant-links.md",
      "title": "Relevant Links",
      "layout": "default.md"
    }
  ],

  "pagesExclude": [
    "**/*-fragment.md",
    "project/setting-up.md",
    "project/unit-testing.md",
    "project/debugging.md",
    "project/code-analysis-coverage.md",
    "project/ui-testing.md",
    "project/load-testing.md"
  ],

  "enableSearch": true,
  "headingIndexingLevel": 4,

  "plugins": [
    "codeBlockCopyButtons",
    "codeBlockWrapButtons",
    "dataTable"
  ],

  "plantumlCheck": false,

  "ignore": [
    "_site/**",
    ".git/**",
    ".github/**",
    "_markbind/logs/**",
    "node_modules/**",
    "scripts/**",
    ".gitignore",
    "site.json",
    "README.md",
    "package.json",
    "package-lock.json",
    "images/content/README.md"
  ],

  "deploy": {
    "message": "Update CS4218 course website",
    "branch": "gh-pages"
  }
}
